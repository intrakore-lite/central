 "fields": [
  {
   "description": "The provider this row configures. It names the record, so there can only ever be one row per adapter — and it cannot be changed once set.",
   "fieldname": "adapter_key",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Adapter",
   "options": "Stripe\nRazorpay\nPaypal\nCheckout",
   "reqd": 1,
   "set_only_once": 1
  },
  {
   "default": "Direct",
   "depends_on": "eval:doc.adapter_key=='Paypal'",
   "description": "Direct (own PayPal account) or Via Razorpay (collected in the Razorpay sheet).",
   "fieldname": "paypal_settlement_mode",
   "fieldtype": "Select",
   "label": "PayPal Settlement Mode",
   "options": "Direct\nVia Razorpay"
  },
  {
   "default": "Sandbox",
   "depends_on": "eval:doc.adapter_key=='Checkout'",
   "description": "Sandbox calls api.sandbox.checkout.com and needs sandbox keys (sk_sbox_, pk_sbox_). Live calls api.checkout.com. For Checkout.com, API Key is the public key, API Secret is the secret key and Webhook Secret is the signature key of the webhook workflow, which Central sets when it registers the webhook.",
   "fieldname": "checkout_environment",
   "fieldtype": "Select",
   "label": "Checkout Environment",
   "options": "Sandbox\nLive"
  },
  {
   "depends_on": "eval:doc.adapter_key=='Checkout'",
   "description": "The processing channel (pc_...) every Checkout.com payment is made on. Find it in the Checkout.com Dashboard, Settings, Channels.",
   "fieldname": "processing_channel_id",
   "fieldtype": "Data",
   "label": "Processing Channel ID",
   "mandatory_depends_on": "eval:doc.adapter_key=='Checkout' && doc.is_enabled"
  },
  {
   "depends_on": "eval:doc.adapter_key=='Checkout'",
   "description": "Optional. The account's own API host prefix from the Checkout.com Dashboard (Developers, Overview), so calls go to https://<prefix>.api.checkout.com. Empty uses the shared host.",
   "fieldname": "checkout_api_prefix",
   "fieldtype": "Data",
   "label": "Checkout API Prefix"
  },
  {
   "fieldname": "column_break_flags",
   "fieldtype": "Column Break"
  },
